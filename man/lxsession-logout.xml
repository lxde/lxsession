    <refentrytitle>lxsession-logout</refentrytitle>
    <refmiscinfo class="source">https://lxde.org</refmiscinfo>
    <refmiscinfo class="manual">General Commands Manual</refmiscinfo>
  </refmeta>
  <refnamediv>
    <refname>lxsession-logout</refname>
    <refpurpose>log out of LXSession</refpurpose>
  </refnamediv>
  <refsynopsisdiv>
    <cmdsynopsis>
      <command>lxsession-logout</command>
      <arg rep="repeat">
        <option><replaceable>OPTIONS</replaceable></option>
      </arg>
    </cmdsynopsis>
  </refsynopsisdiv>
  <refsect1>
    <title>DESCRIPTION</title>
    <para>
      <command>lxsession-logout</command> displays a dialog that allows you
      to log out of your session.
    </para>
  </refsect1>
  <refsect1>
    <title>OPTIONS</title>
    <variablelist>
      <varlistentry>
        <term><option>-b</option>, <option>--banner <parameter>logo</parameter></option></term>
        <listitem>
          <para>logo to customize the dialog</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-H</option>, <option>--hide-button&#xA0;<parameter>shutdown</parameter>|<parameter>reboot</parameter>|<parameter>logout</parameter>|<parameter>hibernate</parameter>|@@<parameter>suspend</parameter>|<parameter>switch_user</parameter>|<parameter>lock_screen</parameter></option></term>
        <listitem>
          <para>button to be hidden from the dialog (can be used repeatedly)</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-p</option>, <option>--prompt <parameter>message</parameter></option></term>
        <listitem>
          <para>message to customize the dialog</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-s</option>, <option>--side <parameter>left</parameter>|<parameter>top</parameter>|<parameter>right</parameter>|<parameter>bottom</parameter></option></term>
        <listitem>
          <para>position of the logo</para>
        </listitem>
      </varlistentry>
    </variablelist>
  </refsect1>
