    <refmiscinfo class="manual">General Commands Manual</refmiscinfo>
  </refmeta>
  <refnamediv>
    <refname>lxsession</refname>
    <refpurpose>lightweight X session manager</refpurpose>
  </refnamediv>
  <refsynopsisdiv>
    <cmdsynopsis>
      <command>lxsession</command>
      <arg rep="repeat">
        <option><replaceable>OPTIONS</replaceable></option>
      </arg>
    </cmdsynopsis>
  </refsynopsisdiv>
  <refsect1>
    <title>DESCRIPTION</title>
    <para>
      <command>lxsession</command> is a program that provides an X session
      manager. It is the default X session manager for LXDE.
    </para>
    <para>
      A session manager automatically starts a set of applications and sets
      up a working desktop environment. Additionally, when a user logs out,
      the session manager remembers which applications were in use and
      restarts them the next time the user logs in.
    </para>
  </refsect1>
  <refsect1>
    <title>OPTIONS</title>
    <variablelist>
      <varlistentry>
        <term><option>-a</option>, <option>--noautostart</option></term>
        <listitem>
          <para>disable autostart of applications (window-manager mode only)</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-c</option>, <option>--compatibility <parameter>name</parameter></option></term>
        <listitem>
          <para>specify a compatibility mode for settings (only <parameter>razor-qt</parameter> is supported)</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-e</option>, <option>--de <parameter>name</parameter></option></term>
        <listitem>
          <para>name of the desktop environnement (<parameter>LXDE</parameter> is the default)</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-n</option>, <option>--noxsettings</option></term>
        <listitem>
          <para>disable Xsettings daemon support</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-r</option>, <option>--reload</option></term>
        <listitem>
          <para>reload configurations (for Xsettings daemon)</para>
        </listitem>
      </varlistentry>
      <varlistentry>
        <term><option>-s</option>, <option>--session <parameter>name</parameter></option></term>
        <listitem>
          <para>name of the desktop session profile</para>
        </listitem>
      </varlistentry>
    </variablelist>
  </refsect1>
